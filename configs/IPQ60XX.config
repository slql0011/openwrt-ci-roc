CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_zn_m2=y

# 从 zn_m2 设备默认包列表中剔除 Wi-Fi 驱动、固件和用户空间组件
CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq60xx_DEVICE_zn_m2="-ipq-wifi-zn_m2 -ath11k-firmware-ipq6018 -ath11k-firmware-qcn9074 -kmod-ath -kmod-ath11k -kmod-ath11k-ahb -kmod-ath11k-pci -kmod-cfg80211 -kmod-mac80211 -kmod-qca-nss-drv-wifi-meshmgr -wireless-regdb -wpad-openssl -hostapd-common -iw -wifi-scripts -ucode-mod-nl80211 -rpcd-mod-iwinfo -libiwinfo -libiwinfo-data"

# 内核级彻底关闭无线子系统（与上面的设备包排除互补：即便未来有包尝试 select 这些符号也会被强制关闭）
# 仅在本 IPQ60XX 构建生效，不影响其他 target/subtarget
CONFIG_WLAN=n
CONFIG_CFG80211=n
CONFIG_MAC80211=n

# 用户态 AP 栈也显式关闭（与设备包排除双保险）
CONFIG_PACKAGE_wpad-openssl=n
CONFIG_PACKAGE_hostapd-common=n

# CONFIG_ATH11K_MEM_PROFILE_1G is not set
# CONFIG_ATH11K_MEM_PROFILE_512M is not set
# CONFIG_ATH11K_MEM_PROFILE_256M is not set
CONFIG_NSS_FIRMWARE_VERSION_11_4=y
# CONFIG_ATH11K_NSS_MESH_SUPPORT is not set

CONFIG_PACKAGE_luci-app-athena-led=m
CONFIG_PACKAGE_luci-i18n-athena-led-zh-cn=m

# 删除WIFI驱动相关
# 1. 禁用无线内核驱动与辅助模块
# CONFIG_PACKAGE_kmod-ath is not set
# CONFIG_PACKAGE_kmod-ath11k is not set
# CONFIG_PACKAGE_kmod-ath11k-ahb is not set
# CONFIG_PACKAGE_kmod-ath11k-pci is not set
# CONFIG_PACKAGE_kmod-cfg80211 is not set
# CONFIG_PACKAGE_kmod-mac80211 is not set
# CONFIG_PACKAGE_kmod-qca-nss-drv-wifi-meshmgr is not set
# CONFIG_NSS_DRV_WIFIOFFLOAD_ENABLE is not set
# CONFIG_NSS_DRV_WIFI_EXT_VDEV_ENABLE is not set
# CONFIG_NSS_DRV_WIFI_MESH_ENABLE is not set

# 2. 禁用固件微码与校准数据（省去 20MB+ 空间）
# CONFIG_PACKAGE_ath11k-firmware-ipq6018 is not set
# CONFIG_PACKAGE_ipq-wifi-zn_m2 is not set
# CONFIG_PACKAGE_wireless-regdb is not set

# 3. 禁用 wpad 认证守护进程
# CONFIG_PACKAGE_wpad-openssl is not set
# CONFIG_PACKAGE_hostapd-common is not set

# 4. 禁用命令行工具与 Web 页面注册插件（彻底隐藏 LuCI 无线菜单）
# CONFIG_PACKAGE_iw is not set
# CONFIG_PACKAGE_wifi-scripts is not set
# CONFIG_PACKAGE_ucode-mod-nl80211 is not set
# CONFIG_PACKAGE_rpcd-mod-iwinfo is not set
# CONFIG_PACKAGE_libiwinfo is not set
# CONFIG_PACKAGE_libiwinfo-data is not set

